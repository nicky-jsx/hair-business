NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER prefix with NEXT_PUBLIC_). Needed by /api/upload-url for
# image uploads. Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed site (used for sitemap, robots, social previews).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
